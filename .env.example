# Groq (Phase 2+) - free tier key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_PARSER_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Google Sheets handoff (Phase 3+)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com"}
SHEET_ID=
SHEET_TAB=Leads

# Local runtime
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=./doccaller.db

# Optional: shared secret on POST /missed-call
MISSED_CALL_SHARED_SECRET=

# Maintenance: 2h no-reply sweep + 90-day transcript retention
JOBS_ENABLED=true
JOB_INTERVAL_MINUTES=15
